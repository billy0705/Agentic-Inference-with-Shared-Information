vllm:
  model_name: google/gemma-4-E4B-it
  sif_path: ../vllm-server/vllm.sif
  port: 8000
  log_path: vllm-server.log
  engine_ready_timeout: 1800
  tensor_parallel_size: 4
  max_model_len: 21000
  gpu_memory_utilization: 0.95

helma:
  job_name: gpt-oss
  nodes: 1
  gres: "gpu:4"
  partition: h100
  output: out_single_node.out
  time: "4:00:00"

expt:
  benchmark:
    - gsm8k
  methods:
    - multiagent_dynamic_streaming
  limit: 1
  repeats: 1
  max_steps: 3
  single_agent_min_steps: 3
  single_agent_max_steps: 7
  debate_rounds: 2
  max_tokens: 16384
  benchmark_data_dir: data
  output_dir: output
  resume_run: null
